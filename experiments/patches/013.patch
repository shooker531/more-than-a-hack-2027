+def _parse_and_cache_skillcorner_game(match_id: str, skillcorner_data_dir: str,
+                                      cache_path: str) -> None:
+    """Positions are metres from the centre spot at 10 fps; they are resampled to 25 fps by
+    linear interpolation inside each period (a position is NaN unless both neighbouring 10 fps
+    frames have it) and converted to normalised pitch units. Possession takes the 10 fps frame at
+    or before each 25 fps instant. A frame with no team in possession is dead ball."""
+    with open(os.path.join(skillcorner_data_dir, "{}_match.json".format(match_id))) as handle:
+        match = json.load(handle)
+    pitch_length_m, pitch_width_m = float(match["pitch_length"]), float(match["pitch_width"])
+    home_team_id = match["home_team"]["id"]
+    player_ids = [player["id"] for player in match["players"]]
+    slot_of_player = {player_id: slot for slot, player_id in enumerate(player_ids)}
+    slot_team = np.array([domain.HOME_TEAM if player["team_id"] == home_team_id
+                          else domain.AWAY_TEAM for player in match["players"]], dtype=np.int8)
+
+    frames = []
+    with open(os.path.join(skillcorner_data_dir,
+                           "{}_tracking_extrapolated.jsonl".format(match_id))) as handle:
+        frames = [json.loads(line) for line in handle]
+    frame_index = {frame["frame"]: frame for frame in frames}
+
+    period_blocks = []
+    for period in match["match_periods"]:
+        source = [frame_index.get(number) for number in
+                  range(period["start_frame"], period["end_frame"] + 1)]
+        period_blocks.append(_resample_skillcorner_period(
+            source, slot_of_player, len(player_ids), pitch_length_m, pitch_width_m))
+
+    ball = np.concatenate([block[0] for block in period_blocks])
+    players = np.concatenate([block[1] for block in period_blocks])
+    raw_group = np.concatenate([block[2] for block in period_blocks])
+    graded_halves, truth, offset = [], np.full(len(ball), domain.LABEL_ABSTAIN, dtype="<U1"), 0
+    for half_number, block in enumerate(period_blocks, start=1):
+        half = slice(offset, offset + len(block[0]))
+        is_alive = raw_group[half] != domain.NO_TEAM
+        raw_team = np.where(raw_group[half] == domain.AWAY_TEAM, domain.AWAY_TEAM,
+                            domain.HOME_TEAM).astype(np.int8)
+        controlled_team = _merge_uncontrolled_spells(raw_team, is_alive)
+        truth[half] = np.where(~is_alive, domain.LABEL_DEAD,
+                               np.where(controlled_team == domain.HOME_TEAM, domain.LABEL_HOME,
+                                        domain.LABEL_AWAY))
+        graded_halves.append((half_number, offset, offset + len(block[0]) - 1))
+        offset += len(block[0])
+
+    os.makedirs(os.path.dirname(cache_path), exist_ok=True)
+    np.savez(cache_path, ball=ball.astype(np.float32), players=players.astype(np.float32),
+             slot_team=slot_team, graded_halves=np.array(graded_halves, dtype=np.int64),
+             truth=truth, pitch=np.array([pitch_length_m, pitch_width_m]))
+
+
+def _resample_skillcorner_period(source_frames: list[dict[str, Any] | None],
+                                 slot_of_player: dict[int, int], n_slots: int,
+                                 pitch_length_m: float, pitch_width_m: float
+                                 ) -> tuple[NDArray[np.float64], NDArray[np.float64],
+                                            NDArray[np.int8]]:
+    n_source = len(source_frames)
+    source_ball = np.full((n_source, 2), np.nan)
+    source_players = np.full((n_source, n_slots, 2), np.nan)
+    source_group = np.full(n_source, domain.NO_TEAM, dtype=np.int8)
+    for index, frame in enumerate(source_frames):
+        if frame is None:
+            continue
+        ball_data = frame["ball_data"]
+        if ball_data["x"] is not None:
+            source_ball[index] = (ball_data["x"], ball_data["y"])
+        for player in frame["player_data"]:
+            slot = slot_of_player.get(player["player_id"])
+            if slot is not None and player["x"] is not None:
+                source_players[index, slot] = (player["x"], player["y"])
+        group = (frame["possession"] or {}).get("group")
+        source_group[index] = (domain.HOME_TEAM if group == "home team"
+                               else domain.AWAY_TEAM if group == "away team" else domain.NO_TEAM)
+
+    n_target = int((n_source - 1) * 25 / _SKILLCORNER_FRAMES_PER_SECOND) + 1
+    position = np.arange(n_target) * _SKILLCORNER_FRAMES_PER_SECOND / 25
+    lower = np.minimum(position.astype(np.int64), n_source - 2)
+    fraction = position - lower
+    centre = np.array([pitch_length_m / 2, pitch_width_m / 2])
+    size = np.array([pitch_length_m, pitch_width_m])
+
+    def resample(values: NDArray[np.float64]) -> NDArray[np.float64]:
+        weight = fraction.reshape((-1,) + (1,) * (values.ndim - 1))
+        return values[lower] * (1 - weight) + values[lower + 1] * weight
+
+    ball = np.full((n_target, 3), np.nan)
+    ball[:, :2] = (resample(source_ball) + centre) / size
+    players = np.full((n_target, n_slots, 3), np.nan)
+    players[:, :, :2] = (resample(source_players) + centre) / size
+    group = source_group[np.minimum(np.floor(position).astype(np.int64), n_source - 1)]
+    return ball, players, group
+
+
