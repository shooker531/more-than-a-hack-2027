+def load_skillcorner_game(match_id: str, skillcorner_data_dir: str,
+                          cache_dir: str) -> LabelledGame:
+    cache_path = os.path.join(cache_dir, "skillcorner_{}.npz".format(match_id))
+    if not os.path.isfile(cache_path):
+        _parse_and_cache_skillcorner_game(match_id, skillcorner_data_dir, cache_path)
+    with np.load(cache_path) as cached:
+        tracking = domain.TrackingData(ball_norm=cached["ball"], players_norm=cached["players"],
+                                       slot_team=cached["slot_team"],
+                                       pitch_length_m=float(cached["pitch"][0]),
+                                       pitch_width_m=float(cached["pitch"][1]))
+        graded_halves = [domain.GradedHalf(int(half), int(first), int(last))
+                         for half, first, last in cached["graded_halves"]]
+        truth = cached["truth"].astype("<U1")
+    return LabelledGame(name="skillcorner_{}".format(match_id), tracking=tracking, truth=truth,
+                        graded_halves=graded_halves, is_ball_always_tracked=True)
