+def _phase_team_per_frame(tagging: pd.DataFrame, codes: tuple[str, ...],
+                          n_frames: int) -> domain.FloatPerFrame:
+    """Mean of +1 (home) / -1 (away) over the tags covering each frame, 0 where none do.
+    Overlapping tags for both teams cancel towards 0."""
+    phases = tagging[tagging["code"].isin(codes) & (tagging["team"] != domain.NO_TEAM)]
+    signed_sum = np.zeros(n_frames + 1)
+    tag_count = np.zeros(n_frames + 1)
+    signs = np.where(phases["team"].to_numpy() == domain.HOME_TEAM, 1.0, -1.0)
+    starts = phases["start_video_frame"].to_numpy()
+    ends = phases["end_video_frame"].to_numpy()
+    np.add.at(signed_sum, starts, signs)
+    np.add.at(signed_sum, ends, -signs)
+    np.add.at(tag_count, starts, 1.0)
+    np.add.at(tag_count, ends, -1.0)
+    coverage = np.cumsum(tag_count)[:n_frames]
+    return np.where(coverage > 0, np.cumsum(signed_sum)[:n_frames] / np.maximum(coverage, 1), 0.0)
+
+
 def _signed_team_evidence(evidence: domain.TeamCodePerFrame) -> domain.FloatPerFrame:
     return np.where(evidence == domain.HOME_TEAM, 1.0,
                     np.where(evidence == domain.AWAY_TEAM, -1.0, 0.0))
