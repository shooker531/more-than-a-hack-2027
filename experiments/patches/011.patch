@@ -27,6 +38,76 @@ _TAG_LENGTH_AFTER_RESTART_FRAMES = round(1.5 * config.FRAMES_PER_SECOND)
 _MISSED_SET_PIECE_SHARE = 0.10
 
 
+class _PhaseTagProfile(NamedTuple):
+    code: str
+    tags_per_possession: float
+    start_offset_median_s: float
+    start_offset_sd_s: float
+    length_median_s: float
+    length_log_sd: float
+    wrong_team_share: float
+    # Only possessions at least this long spawn tags; a window may run past the possession's end
+    # by at most |N(0, overrun_sd)| seconds.
+    min_possession_s: float
+    overrun_sd_s: float
+
+
+# Calibrated so the synthetic tags reproduce the real coverage and agreement on the sample games
+# (see the module docstring); the code names are the ones the model features look for.
+_RELIABLE_PHASES = _PhaseTagProfile("build up", 0.9, 1.6, 4.0, 18.7, 0.4, 0.04, 8.0, 5.0)
+_OTHER_PHASES = _PhaseTagProfile("ball in final third", 1.4, -2.4, 4.0, 23.9, 0.4, 0.20, 3.0,
+                                  8.0)
+
+
+def synthesize_tags(events: pd.DataFrame, possession_truth: domain.LabelPerFrame,
+                    graded_halves: list[domain.GradedHalf], seed: int) -> pd.DataFrame:
+    random_generator = np.random.default_rng(seed + 1000)
+    phase_tags = [_synthesize_phase_tags(possession_truth, graded_halves, profile,
+                                         random_generator)
+                  for profile in (_RELIABLE_PHASES, _OTHER_PHASES)]
+    return (pd.concat([synthesize_set_piece_tags(events, graded_halves, seed), *phase_tags],
+                      ignore_index=True)
+            .sort_values("start_video_frame", kind="stable").reset_index(drop=True))
+
+
+def _synthesize_phase_tags(possession_truth: domain.LabelPerFrame,
+                           graded_halves: list[domain.GradedHalf], profile: _PhaseTagProfile,
+                           random_generator: np.random.Generator) -> pd.DataFrame:
+    """Each true possession spawns a Poisson number of phase windows near its start, with the
+    measured offset and length spread; a share is attributed to the wrong team. Windows are
+    clipped to the half and are not aligned to the possession's end, as in the real export."""
+    rows = []
+    fps = config.FRAMES_PER_SECOND
+    team_code_by_label = {domain.LABEL_HOME: domain.HOME_TEAM, domain.LABEL_AWAY: domain.AWAY_TEAM,
+                          domain.LABEL_DEAD: domain.NO_TEAM, domain.LABEL_ABSTAIN: domain.NO_TEAM}
+    for graded_half in graded_halves:
+        half_start, half_end = graded_half.first_video_frame, graded_half.last_video_frame + 1
+        half_teams = np.array([team_code_by_label[label]
+                               for label in possession_truth[half_start:half_end]],
+                              dtype=np.int8)
+        eligible_spells = [(spell_start, spell_end, team) for spell_start, spell_end, team
+                           in runs.equal_value_runs(half_teams)
+                           if team != domain.NO_TEAM
+                           and spell_end - spell_start >= profile.min_possession_s * fps]
+        for spell_start, spell_end, team in eligible_spells:
+            for _ in range(int(random_generator.poisson(profile.tags_per_possession))):
+                start = half_start + spell_start + int(fps * random_generator.normal(
+                    profile.start_offset_median_s, profile.start_offset_sd_s))
+                latest_end = half_start + spell_end + int(
+                    fps * abs(random_generator.normal(0.0, profile.overrun_sd_s)))
+                length = min(int(fps * profile.length_median_s
+                                 * np.exp(random_generator.normal(0.0, profile.length_log_sd))),
+                             max(latest_end - start, fps))
+                is_wrong_team = random_generator.random() < profile.wrong_team_share
+                rows.append({"code": profile.code, "set_piece_type": "",
+                             "team": (1 - team) if is_wrong_team else team,
+                             "start_video_frame": int(np.clip(start, half_start, half_end - 1)),
+                             "end_video_frame": int(np.clip(start + length, half_start + 1,
+                                                            half_end))})
+    return pd.DataFrame(rows, columns=["code", "set_piece_type", "team", "start_video_frame",
+                                       "end_video_frame"]).astype({"team": np.int8})
+
+
 def synthesize_set_piece_tags(events: pd.DataFrame, graded_halves: list[domain.GradedHalf],
                               seed: int) -> pd.DataFrame:
     random_generator = np.random.default_rng(seed)
