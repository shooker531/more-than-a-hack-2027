+"""Viterbi decoder: the most likely H / A / D sequence for each graded half.
+
+Entry point: decode_possession_labels.
+
+Each frame gives every state a score from the evidence on that frame (touches and control for
+a team; ball missing, out of play, players walking, set-piece windows for dead ball; a visible
+ball against dead ball). Every change of state pays a cost. The decoder picks the labelling with
+the highest total score minus costs over the whole half.
+
+This replaces the rule decoder's hard thresholds with one trade-off: a switch or a dead stretch
+happens only when the evidence for it outweighs its cost, and evidence of every kind adds up.
+Before each half's kick-off is forced dead (the scorer grades those frames as D). Ungraded
+frames are X.
+
+Known limitation (standard HMM): possession length has no explicit model, so very short
+possessions are only discouraged by the switch cost. A semi-Markov decoder would add a duration
+model if that turns out to matter.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+from numpy.typing import NDArray
+
+from . import config, domain
+
+_HOME, _AWAY, _DEAD = 0, 1, 2
+_STATE_LABELS = np.array([domain.LABEL_HOME, domain.LABEL_AWAY, domain.LABEL_DEAD])
+# Large enough that no amount of evidence can outweigh it.
+_FORCED_SCORE = 1e6
+
+
+def decode_possession_labels(frame_features: domain.FrameFeatures,
+                             control_evidence: domain.TeamCodePerFrame,
+                             touch_evidence: domain.TeamCodePerFrame,
+                             dead_ball_signals: domain.DeadBallSignals,
+                             graded_halves: list[domain.GradedHalf],
+                             pipeline_config: config.PipelineConfig) -> domain.LabelPerFrame:
+    state_scores = _score_states_per_frame(frame_features, control_evidence, touch_evidence,
+                                           dead_ball_signals, pipeline_config)
+    transition_costs = _transition_cost_matrix(pipeline_config)
+    labels = np.full(len(control_evidence), domain.LABEL_ABSTAIN, dtype="<U1")
+    for graded_half in graded_halves:
+        half_slice = slice(graded_half.first_video_frame, graded_half.last_video_frame + 1)
+        best_states = _most_likely_state_sequence(state_scores[half_slice], transition_costs)
+        labels[half_slice] = _STATE_LABELS[best_states]
+    return labels
+
+
+def _score_states_per_frame(frame_features: domain.FrameFeatures,
+                            control_evidence: domain.TeamCodePerFrame,
+                            touch_evidence: domain.TeamCodePerFrame,
+                            dead_ball_signals: domain.DeadBallSignals,
+                            pipeline_config: config.PipelineConfig) -> NDArray[np.float64]:
+    """(n_frames, 3) scores for H, A, D. Only differences between states matter."""
+    scores = np.zeros((len(control_evidence), 3))
+    touch_starts = _touch_start_frames(touch_evidence,
+                                       pipeline_config.control_episode_max_gap_frames)
+    for team_state, team_code in ((_HOME, domain.HOME_TEAM), (_AWAY, domain.AWAY_TEAM)):
+        scores[:, team_state] += (pipeline_config.viterbi_control_weight
+                                  * (control_evidence == team_code))
+        scores[touch_starts[team_code], team_state] += pipeline_config.viterbi_touch_weight
+
+    is_tracked = frame_features.is_ball_tracked
+    scores[:, _DEAD] += (pipeline_config.viterbi_ball_untracked_dead_weight * ~is_tracked
+                         - pipeline_config.viterbi_ball_tracked_live_weight * is_tracked
+                         + pipeline_config.viterbi_ball_out_dead_weight
+                         * frame_features.is_ball_out_of_pitch
+                         + pipeline_config.viterbi_walking_dead_weight
+                         * dead_ball_signals.is_walking_stoppage
+                         + pipeline_config.viterbi_set_piece_window_dead_weight
+                         * dead_ball_signals.is_set_piece_window
+                         + _FORCED_SCORE * dead_ball_signals.is_before_kick_off)
+
+    team_tagged = dead_ball_signals.set_piece_teams != domain.NO_TEAM
+    for restart_frame, team_code in zip(dead_ball_signals.set_piece_restart_frames[team_tagged],
+                                        dead_ball_signals.set_piece_teams[team_tagged]):
+        team_state = _HOME if team_code == domain.HOME_TEAM else _AWAY
+        scores[restart_frame:restart_frame + pipeline_config.viterbi_set_piece_team_frames,
+               team_state] += pipeline_config.viterbi_set_piece_team_weight
+    return scores
+
+
+def _touch_start_frames(touch_evidence: domain.TeamCodePerFrame,
+                        max_gap_frames: int) -> dict[int, NDArray[np.int64]]:
+    """First frame of each touch, per team. A touch scores once, however many frames the ball
+    stays near the player: per-frame scoring let one long dribble outweigh an interception plus
+    a pass (two touches of a few frames each), so no single switch cost could accept the second
+    while rejecting scrambles. Frames of one team's evidence separated by a hole up to
+    max_gap_frames belong to the same touch."""
+    starts: dict[int, NDArray[np.int64]] = {}
+    for team_code in (domain.HOME_TEAM, domain.AWAY_TEAM):
+        team_frames = np.flatnonzero(touch_evidence == team_code)
+        is_new_touch = np.diff(team_frames, prepend=-max_gap_frames - 2) > max_gap_frames + 1
+        starts[team_code] = team_frames[is_new_touch]
+    return starts
+
+
+def _transition_cost_matrix(pipeline_config: config.PipelineConfig) -> NDArray[np.float64]:
+    """costs[from_state, to_state]. From dead ball either team can take over at the same cost,
+    so the restart team is decided by the evidence after it, not by who had the ball before."""
+    switch = pipeline_config.viterbi_switch_cost
+    enter_dead = pipeline_config.viterbi_enter_dead_cost
+    exit_dead = pipeline_config.viterbi_exit_dead_cost
+    return np.array([[0.0, switch, enter_dead],
+                     [switch, 0.0, enter_dead],
+                     [exit_dead, exit_dead, 0.0]])
+
+
+def _most_likely_state_sequence(state_scores: NDArray[np.float64],
+                                transition_costs: NDArray[np.float64]) -> NDArray[np.int64]:
+    """Standard Viterbi: best total up to each frame per state, then trace back. The loop is over
+    frames with 3x3 numpy steps — ~80k frames per half, a second or two."""
+    n_frames = len(state_scores)
+    best_previous_state = np.zeros((n_frames, 3), dtype=np.int8)
+    running_best = state_scores[0].copy()
+    for frame in range(1, n_frames):
+        candidate_totals = running_best[:, None] - transition_costs
+        best_previous_state[frame] = candidate_totals.argmax(axis=0)
+        running_best = candidate_totals.max(axis=0) + state_scores[frame]
+
+    best_states = np.zeros(n_frames, dtype=np.int64)
+    best_states[-1] = int(running_best.argmax())
+    for frame in range(n_frames - 1, 0, -1):
+        best_states[frame - 1] = best_previous_state[frame, best_states[frame]]
+    return best_states
