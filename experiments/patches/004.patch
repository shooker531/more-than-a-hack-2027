+def _detect_dead_ball_gaps(frame_features: domain.FrameFeatures,
+                           pipeline_config: config.PipelineConfig) -> domain.BoolPerFrame:
+    """Long untracked-ball gaps are dead, except those that look like live play."""
+    is_dead = np.zeros(len(frame_features.is_ball_tracked), dtype=bool)
+    long_gaps = [(gap_start, gap_end)
+                 for gap_start, gap_end in runs.true_runs(~frame_features.is_ball_tracked)
+                 if gap_end - gap_start >= pipeline_config.ball_gap_dead_min_duration_frames]
+    for gap_start, gap_end in long_gaps:
+        is_dead[gap_start:gap_end] = not _looks_like_live_play(gap_start, gap_end, frame_features,
+                                                               pipeline_config)
+    return is_dead
+
+
+def _looks_like_live_play(gap_start: int, gap_end: int, frame_features: domain.FrameFeatures,
+                          pipeline_config: config.PipelineConfig) -> bool:
+    """A gap at the very start of the recording has no last-seen position; NaN compares False,
+    so it is treated as dead."""
+    last_seen_line_distance_m = frame_features.ball_distance_to_nearest_line_m[max(gap_start - 1,
+                                                                                   0)]
+    is_walking = (frame_features.median_player_speed_mps[gap_start:gap_end]
+                  < pipeline_config.stoppage_player_speed_mps)
+    longest_walking_frames = max((end - start for start, end in runs.true_runs(is_walking)),
+                                 default=0)
+    return bool(last_seen_line_distance_m > pipeline_config.live_gap_min_last_seen_line_distance_m
+                and longest_walking_frames < pipeline_config.live_gap_max_walking_frames)
+
+
