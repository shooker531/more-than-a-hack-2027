 _CONTEXT_WINDOWS_FRAMES = (13, 51, 125)
 _PRESSING_RADIUS_M = 5.0
 _CENTROID_VELOCITY_SPAN_FRAMES = 25
+# The block's shape changes slowly, so the (relatively costly) convex hull is computed every 5th
+# frame and linearly interpolated in between.
+_HULL_FRAME_STEP = 5
+_PRESS_LINE_PLAYERS = 3
 
 _INSTANT_FEATURES = (
     "nearest_home_m", "nearest_away_m", "nearest_difference_m", "ball_speed_mps",
