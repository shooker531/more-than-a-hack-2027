                  + ["{}_mean_{}f".format(name, window) for window in _CONTEXT_WINDOWS_FRAMES
                     for name in _SMOOTHED_FEATURES])
@@ -79,6 +88,16 @@ def compute_model_features(tracking: domain.TrackingData, frame_features: domain
         "length_difference_m": home["length_m"] - away["length_m"],
         "speed_difference_mps": home["mean_speed_mps"] - away["mean_speed_mps"],
         "pressing_difference": home["players_near_ball"] - away["players_near_ball"],
+        "hull_area_difference_m2": home["hull_area_m2"] - away["hull_area_m2"],
+        "defensive_line_difference_m": home["defensive_line_m"] - away["defensive_line_m"],
+        "press_height_difference_m": home["press_height_m"] - away["press_height_m"],
+        "opponent_half_share_difference": home["opponent_half_share"]
+        - away["opponent_half_share"],
